# Copy this file to .env and fill in your real values.
# Never commit the real .env file anywhere.

# From @BotFather on Telegram (/newbot)
TELEGRAM_BOT_TOKEN=

# From aistudio.google.com -> Get API key
GEMINI_API_KEY=

# Your Apple ID email (the one your iCloud calendar is on)
ICLOUD_APPLE_ID=

# The app-specific password generated at appleid.apple.com
# (Sign-In and Security -> App-Specific Passwords). NOT your normal Apple ID password.
ICLOUD_APP_SPECIFIC_PASSWORD=

# Name of the dedicated iCloud calendar the bot should write to.
# Create this calendar first (on iPhone: Calendar app -> Calendars -> Add Calendar,
# or iCloud.com -> Calendar -> Add Calendar). Must match exactly.
ICLOUD_CALENDAR_NAME=Bot Events

# Optional: each person's usual calendar, so their own is offered as the first
# button on the review card. Format: "111111111:Bot Events,222222222:Family".
# You still tap to choose -- this only decides the button order.
DEFAULT_CALENDAR_MAP=

# Telegram numeric user ID(s) allowed to use this bot -- comma-separate
# multiple people, e.g. "111111,222222". REQUIRED: the bot refuses to start
# with this blank, so set it BEFORE the first start. Find your numeric user ID
# by messaging a Telegram ID bot such as @userinfobot (a second person does the same).
# This stops ANYONE who finds your bot's username from adding
# events to your calendar. Everyone listed here confirms into the SAME
# calendar (ICLOUD_CALENDAR_NAME) -- there's only one iCloud account configured.
TELEGRAM_ALLOWED_USER_ID=
